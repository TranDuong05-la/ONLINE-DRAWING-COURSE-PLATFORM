# Copy to .env and replace each placeholder locally. Never commit .env.
DB_URL=<required-mysql-jdbc-url-without-createDatabaseIfNotExist>
DB_USERNAME=<required-local-database-user>
DB_PASSWORD=<required-local-database-password>
JWT_SECRET=<required-random-secret-at-least-256-bits>

# Optional integrations. Leave unset if unused.
# MAIL_USERNAME=<smtp-user>
# MAIL_PASSWORD=<smtp-password>
# GOOGLE_CLIENT_ID=<oauth-client-id>
